# Clave de API de Resend (https://resend.com/api-keys).
# Sin ella el formulario de /acerca-de finge el envio: valida, registra el
# mensaje en la consola del servidor y devuelve exito, para que el repo se
# pueda clonar y construir sin cuenta de Resend.
RESEND_API_KEY=
SUPABASE_DB_PASSWORD=

# --- Supabase (proyecto nlfwqnmidfdohuyhklqp) ---
# A diferencia de Resend, aquí no se finge nada: sin estas variables, pedir un
# cliente de Supabase lanza un error que nombra la que falta. El repo sigue
# clonándose y construyéndose igual, porque hoy solo las pide la ruta de
# diagnóstico /api/supabase-health, que responde 503.
# Los tres valores están en el panel: Project Settings > API Keys.

# URL del proyecto. Viaja al navegador.
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública, formato sb_publishable_... Viaja al navegador; lo que se pueda
# hacer con ella lo decide RLS, no el secreto de la clave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave de servidor, formato sb_secret_... NUNCA lleva prefijo NEXT_PUBLIC_.
# Declarada y validada, pero todavía sin ningún consumidor en el código.
SUPABASE_SECRET_KEY=