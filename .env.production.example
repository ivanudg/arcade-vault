# --- Variables de PRODUCCION ---
#
# Plantilla del bloque que se pega en el host del despliegue (Vercel, Netlify, VPS...).
# El archivo relleno se llama `.env.production.local`, lo ignora git y **no se pega en el
# chat**: el proyecto de produccion queda fuera del alcance de Claude a proposito.
# Los pasos completos estan en `docs/produccion/runbook.md`, fase 4.
#
# Los tres valores de Supabase salen del panel del proyecto de PRODUCCION:
# Project Settings > API Keys. Los de desarrollo estan en `.env.example` y son otros.

# URL del proyecto de produccion, https://<REF_PROD>.supabase.co. Viaja al navegador.
NEXT_PUBLIC_SUPABASE_URL=

# Clave publica, formato sb_publishable_... Viaja al navegador; lo que se pueda hacer con
# ella lo decide RLS mas los permisos minimos de SPEC 18 y 19, no el secreto de la clave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave de servidor, formato sb_secret_... NUNCA lleva prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Clave de API de Resend. Sin ella el formulario de /acerca-de finge el envio: en
# produccion eso significa que los mensajes se pierden en silencio y solo lo delata un
# registro en la consola del servidor.
RESEND_API_KEY=

# SUPABASE_DB_PASSWORD **no va aqui**: es solo para el CLI al aplicar migraciones y el
# runtime no la usa. Subirla al host es dar la base de datos entera sin necesidad.
